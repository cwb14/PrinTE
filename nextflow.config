manifest {
    name            = 'cwb14/PrinTE'
    author          = 'Chris Benson'
    description     = 'Forward simulator of transposable-element genome evolution'
    homePage        = 'https://github.com/cwb14/PrinTE'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '1.0.0'
}

params {
    help   = false
    mode   = 'simulate'          // 'simulate' or 'sweep'
    outdir = 'results'

    // Starting point: build a burn-in here, or bring your own genome + BED.
    fasta             = null
    bed               = null
    size              = '100Mb'
    chr_number        = 1
    cds_percent       = 4
    intact_te_percent = 10
    frag_te_percent   = 0

    // Inputs. clean_lib skips library preprocessing; te_lib does not.
    te_lib    = null
    clean_lib = null
    cds       = null
    ratios    = null

    // Evolution
    generation_end = 10000
    step           = 5000
    mutation_rate  = 1.3e-8
    tstv           = 1.0
    seed           = 42
    insert_rate    = 1e-8
    delete_rate    = 1e-7
    solo_rate      = 95
    length_bias    = 10
    postproc       = false

    // Sweep only. The grid is the same four axes the Python front-ends search.
    ins_start = 1e-9
    ins_end   = 1e-11
    ins_count = 3
    del_start = 1e-9
    del_end   = 1e-11
    del_count = 3
    sr_start  = 90
    sr_end    = 95
    sr_step   = 5
    k_start   = 0
    k_end     = 10
    k_step    = 5
    ref_tsv   = null
    ref_fasta = null
    exp_tsv_name = 'ltr.tsv'
    dist_metric = 'rms'
    alphas      = '0 0 10 1'

}

// Resource defaults. Loaded before profiles so a profile can override them.
includeConfig 'nf/conf/base.config'

profiles {
    local {
        process.executor = 'local'
    }
    conda {
        conda.enabled = true
        process.conda = "$projectDir/environment.yml"
    }
    docker {
        docker.enabled = true
        // Without this, files in a bind mount come back owned by root.
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ghcr.io/cwb14/printe:latest'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container = 'ghcr.io/cwb14/printe:latest'
    }
    slurm    { includeConfig 'nf/conf/slurm.config'    }
    awsbatch { includeConfig 'nf/conf/awsbatch.config' }
    test     { includeConfig 'nf/conf/test.config'     }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

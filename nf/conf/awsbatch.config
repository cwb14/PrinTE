// AWS Batch. See docs/aws-batch.md for the queue and IAM prerequisites.
//
//   nextflow run . -profile awsbatch,docker \
//       -work-dir s3://my-bucket/printe-work \
//       --awsqueue my-batch-queue --outdir s3://my-bucket/printe-results

params.awsqueue  = null
params.awsregion = 'us-east-1'

process {
    executor  = 'awsbatch'
    queue     = params.awsqueue
    container = 'ghcr.io/cwb14/printe:latest'
}

aws {
    region = params.awsregion
    batch {
        // Large FASTA staging in and out is the bottleneck, not compute.
        maxParallelTransfers = 8
        maxTransferAttempts  = 3
        delayBetweenAttempts = '30 sec'
    }
}

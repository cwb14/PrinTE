// Tiny end-to-end run on the repo's own test fixtures. This is what CI executes.

params {
    size              = '60kb'
    chr_number        = 1
    cds_percent       = 4
    intact_te_percent = 10
    frag_te_percent   = 5

    clean_lib = "$projectDir/tests/data/tiny_TE.lib"
    cds       = "$projectDir/tests/data/tiny_cds.fa"
    ratios    = "$projectDir/tests/data/tiny_ratios.tsv"

    generation_end = 200
    step           = 100
    insert_rate    = 1e-5
    delete_rate    = 1e-5
    seed           = 42

    // Four combinations is enough to prove the scatter-gather wiring.
    ins_start = 1e-5
    ins_end   = 1e-6
    ins_count = 2
    del_start = 1e-5
    del_end   = 1e-6
    del_count = 2
    sr_start  = 95
    sr_end    = 95
    sr_step   = 5
    k_start   = 0
    k_end     = 0
    k_step    = 1

}

process {
    cpus   = 2
    memory = '3.GB'
    time   = '1.h'
    withLabel: process_low    { cpus = 1; memory = '2.GB' }
    withLabel: process_medium { cpus = 2; memory = '3.GB' }
    withLabel: process_high   { cpus = 2; memory = '3.GB' }
}

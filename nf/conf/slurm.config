// No partition, account, or QOS is named here on purpose: those are site-specific.
// Set them on the command line, e.g.
//   nextflow run . -profile slurm,singularity \
//       --outdir results -process.queue mypartition -process.clusterOptions '-A myacct'

process {
    executor      = 'slurm'
    scratch       = true
    maxRetries    = 2
}

executor {
    queueSize          = 100
    submitRateLimit    = '10/1min'
}

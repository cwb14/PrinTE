// Resource labels. Memory doubles on a retry because every genome-touching step in
// PrinTE holds the whole genome in RAM, so an OOM is the failure you actually hit
// when a run outgrows its allocation.

process {
    cpus   = 1
    memory = '4.GB'
    time   = '2.h'

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] && task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = '2.h'
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '8.h'
    }
    withLabel: process_high {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = '24.h'
    }
}
